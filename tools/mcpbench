def benchmark_all_servers(write_demo: false)
  puts "Benchmarking all servers..."
  
  # Get all server directories
  servers = Dir.glob("templates/servers/*").select { |f| File.directory?(f) }.map { |f| File.basename(f) }
  
  servers.each do |server|
    benchmark_server(server, write_demo: write_demo)
    puts ""
  end
end

# Parse command line options
options = {}
OptionParser.new do |opts|
  opts.banner = "Usage: tools/mcpbench [options]"
  
  opts.on("--server SERVER", "Benchmark a specific server") do |server|
    options[:server] = server
  end
  
  opts.on("--all", "Benchmark all servers") do
    options[:all] = true
  end
  
  opts.on("--write", "Write demo.md files") do
    options[:write] = true
  end
  
  opts.on("--verbose", "Show detailed output") do
    options[:verbose] = true
  end
  
  opts.on("--json", "Output JSON") do
    options[:json] = true
  end
  
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit
  end
end.parse!

# Main execution
if options[:all]
  benchmark_all_servers(write_demo: options[:write])
elsif options[:server]
  benchmark_server(options[:server], write_demo: options[:write], verbose: options[:verbose])
else
  puts "Please specify a server with --server or use --all for all servers"
  puts "Run with --help for usage information"
end