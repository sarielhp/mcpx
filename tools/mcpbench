def run_opencode(prompt, dir = ".")
  # Run opencode with JSON output format
  stdout, stderr, status = Open3.capture3(
    "opencode run --format json --dir #{dir}",
    stdin_data: prompt
  )
  
  if status.success?
    # Parse JSON events
    events = stdout.split("\n").map { |line| JSON.parse(line) rescue nil }.compact
    
    # Extract token usage from the session
    session_event = events.find { |e| e["type"] == "session" }
    if session_event && session_event["data"]
      data = session_event["data"]
      return {
        input_tokens: data["tokens"]["input"],
        output_tokens: data["tokens"]["output"],
        total_tokens: data["tokens"]["input"] + data["tokens"]["output"],
        cost: data["cost"]
      }
    end
  end
  
  # Fallback if we can't extract data
  puts "Error running opencode: #{stderr}" unless stderr.empty?
  return { input_tokens: 0, output_tokens: 0, total_tokens: 0, cost: 0.0 }
end

def benchmark_server(server_name, write_demo: false, verbose: false)
  template_path = "templates/servers/#{server_name}/template.json"
  
  if !File.exist?(template_path)
    puts "Template not found: #{template_path}"
    return
  end
  
  # Get the prompts for this server
  prompts = PROMPTS[server_name] || {}
  
  if prompts.empty?
    puts "No predefined prompts for server: #{server_name}"
    return
  end
  
  puts "═══ #{server_name.capitalize} MCP Server — Token-Savings Demo ═══"
  puts "This demo shows how MCP servers reduce token usage."
  puts ""
  
  # For now, just show a sample calculation
  puts "Sample Calculation:"
  puts "Without MCP: AI must explain tool syntax and usage"
  puts "  Example: \"I'll use the GitHub API to list your repositories...\""
  puts "  Estimated tokens: ~100"
  puts ""
  puts "With MCP: AI calls the tool directly"
  puts "  Example: \"github_repo_list()\""
  puts "  Estimated tokens: ~15"
  puts ""
  puts "Savings: ~85 tokens (6.7× reduction)"
  puts ""
  
  # Show the tool list
  puts "#{server_name.capitalize} MCP Server Tools:"
  prompts.keys.each do |tool|
    puts "  • #{tool}"
  end
  puts ""
  
  # Write demo.md if requested
  if write_demo
    write_demo_md(server_name, prompts)
  end
end

