#!/usr/bin/env ruby
# scan_secrets — security & privacy violation scanner for the mcpx / mcp-templates
# repositories.
#
# Scans the working tree for anything that must NEVER be committed: API keys,
# passwords, private keys, tokens, credit-card numbers, or `.env` files. It also
# validates template.json / preset.json so every `env.*.value` is a `${VAR}`
# placeholder (never a literal secret) and every preset references an existing
# server.
#
# Run before ANY commit — manually, via `tools/snapshot --check`, or via the
# `.githooks/pre-commit` hook.
#
# Usage:
#   tools/scan_secrets                # scan whole tree
#   tools/scan_secrets --path dir      # scan a directory
#   tools/scan_secrets --json          # JSON output (CI)
#   tools/scan_secrets --verbose       # show each checked file
#
# Exit: 0 when clean; 1 when violations are found.

require 'optparse'
require 'json'
require 'set'

# Deliberately conservative — any match is reported for human review.
KNOWN_PATTERNS = [
  { re: /ghp_[A-Za-z0-9]{20,}/,                 label: 'GitHub PAT (ghp_)' },
  { re: /gho_[A-Za-z0-9]{20,}/,                 label: 'GitHub OAuth (gho_)' },
  { re: /github_pat_[A-Za-z0-9_]{20,}/i,        label: 'GitHub fine-grained PAT' },
  { re: /sk-[A-Za-z0-9]{20,}/,                  label: 'OpenAI-style key (sk-)' },
  { re: /xox[baprs]-[A-Za-z0-9-]{10,}/,         label: 'Slack token (xox*)' },
  { re: /AKIA[0-9A-Z]{16}/,                     label: 'AWS access key (AKIA)' },
  { re: /AIza[0-9A-Za-z_-]{35}/,                label: 'Google API key' },
  { re: /-----BEGIN (?:RSA|EC|OPENSSH|PGP|PRIVATE) PRIVATE KEY-----/, label: 'private key' },
  { re: /-----BEGIN CERTIFICATE-----/,           label: 'certificate' },
  { re: /eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}/, label: 'JWT' },
  # Generic credential assignment — but skip lines that use ${VAR} or are placeholders.
  {
    re: /(?:api[_-]?key|secret|token|password|passwd|pwd|client[_-]?secret)\s*[:=]\s*"?([^$\s"'{}][^\s"',}]{8,})/i,
    label: 'hardcoded credential'
  }
].freeze

# Files Git considers tracked .env files (git ls-files), indexed case-insensitively.
def tracked_env_files_candidates(root)
  out = nil
  begin
    out = IO.popen(['git', 'ls-files', '-z'], chdir: root, err: [:child, :out], &:read)
  rescue StandardError
    out = ''
  end
  (out || '').split("\0").select { |p| p =~ /(?:^|\/)\.env(?:\.[A-Za-z0-9_-]+)?$/ }
end

def collect_files(root, verbose)
  root = File.expand_path(root)
  files = []
  env_files = []
  Dir.glob(File.join(root, '**', '*'), File::FNM_DOTMATCH).each do |f|
    next unless File.file?(f)
    rel = f.sub(root + '/', '')
    next if rel.start_with?('.git/')
    next if rel.start_with?('.githooks/')
    # Flag ANY .env file present in the tree, even if untracked.
    if File.basename(f) =~ /^\.env(\.[A-Za-z0-9_-]+)?$/
      env_files << rel
      next
    end
    next if f == File.join(root, 'mcpx') || f == File.join(root, 'bin')
    next if File.extname(f) =~ /\.(png|jpg|jpeg|gif|ico|pdf|zip|tar|gz|lock|sum|exe|dll|so|dylib)$/
    files << f
  end
  [files.sort, env_files]
end

def scan_file(file, root)
  rel = file == root ? File.basename(file) : file.sub(root + '/', '')
  hits = []
  begin
    content = File.read(file)
    content.force_encoding('UTF-8')
    content = content.scrub('�')
  rescue StandardError
    return hits
  end
  content.each_line.with_index(1) do |line, i|
    # Skip comment/example/documentation lines that only name the pattern.
    stripped = line.strip
    next if stripped.start_with?('#', '//', '<!--')
    # Skip the scanner's own pattern-literal definitions (they legitimately
    # contain example secret shapes like "-----BEGIN CERTIFICATE-----").
    next if file =~ /scan_secrets/ && stripped.include?('BEGIN CERTIFICATE') && stripped !~ /-----BEGIN (RSA|EC|OPENSSH|PGP|PRIVATE) PRIVATE KEY-----/
    next if stripped.start_with?('re:', '/', '  { re:')

    KNOWN_PATTERNS.each do |pat|
      next unless line =~ pat[:re]
      # Do not flag ${VAR} placeholder-style references.
      next if pat[:re].source.include?('api[_-]?key') && line =~ /\$\{[A-Z_]/
      hits << [rel, i, pat[:label], line.strip[0, 120]]
      break
    end
  end
  hits
end

def validate_template(file, root_rel)
  rel = file.sub(root_rel + '/', '')
  hits = []
  data = begin
    JSON.parse(File.read(file))
  rescue StandardError => e
    return [[rel, 1, "invalid JSON: #{e.message}"]]
  end
  (data['env'] || {}).each do |k, v|
    value = v.is_a?(Hash) ? v['value'].to_s : ''
    next if value.empty?
    hits << [rel, 1, "env[#{k}] value is a literal (must be \\${VAR}): #{value.inspect}"] unless value =~ /\A\$(\{[A-Z_][A-Z0-9_]*\})\z/
  end
  hits
end

def validate_preset(file, root_rel)
  rel = file.sub(root_rel + '/', '')
  data = begin
    JSON.parse(File.read(file))
  rescue StandardError => e
    return [[rel, 1, "invalid JSON: #{e.message}"]]
  end
  servers = data['servers'] || []
  missing = servers.reject do |s|
    File.exist?(File.join(root_rel, 'servers', s, 'template.json'))
  end
  missing.map { |m| [rel, 1, "preset references missing server '#{m}'"] }
end

def human_block(banner, entries)
  return '' if entries.empty?
  out = banner + "\n"
  entries.each { |f, l, m| out << "  #{f}:#{l} — #{m}\n" }
  out
end

def main(argv)
  opts = { path: '.', json: false, verbose: false }
  OptionParser.new do |o|
    o.on('--path DIR', 'Scan directory (default: .)') { |v| opts[:path] = v }
    o.on('--json', 'JSON output (CI)') { opts[:json] = true }
    o.on('--verbose') { opts[:verbose] = true }
    o.on('-h', '--help', 'Show help') { puts o.banner; exit 0 }
  end.parse!(argv)

  root = File.expand_path(opts[:path])
  violations = []

  # 1. Tracked .env files (from git, authoritative)
  tracked_env_files_candidates(root).each do |f|
    violations << [f, 1, 'tracked .env file — MUST NOT be committed']
  end

  # 2. Walk content
  files, env_files = collect_files(root, opts[:verbose])
  env_files.each do |f|
    violations << [f, 1, 'present .env file — MUST NOT be committed']
  end
  files.each do |f|
    scan_file(f, root).each { |h| violations << h }
  end

  # 3. Validate templates/presets schema
  Dir.glob(File.join(root, 'servers', '*', 'template.json')).sort.each do |f|
    violations.concat(validate_template(f, root))
  end
  Dir.glob(File.join(root, 'presets', '*', 'preset.json')).sort.each do |f|
    violations.concat(validate_preset(f, root))
  end

  if opts[:json]
    puts JSON.generate(hits: violations.map { |f, l, m| { file: f, line: l, issue: m } })
  elsif violations.empty?
    puts "scan_secrets: clean (#{files.size} files scanned)" if opts[:verbose] || opts[:json]
    puts 'scan_secrets: clean' unless opts[:json]
  else
    puts "scan_secrets: #{violations.size} violation(s) found"
    violations.each { |f, l, m| puts "  #{f}:#{l} — #{m}" }
  end

  violations.empty? ? 0 : 1
end

exit(main(ARGV.dup))