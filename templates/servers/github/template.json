{
  "name": "github",
  "url": "https://github.com/modelcontextprotocol/server-github",
  "description": "GitHub API integration for issues, PRs, and repos",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-github"
  ],
  "env": {
    "GITHUB_PERSONAL_ACCESS_TOKEN": {
      "value": "${GITHUB_PERSONAL_ACCESS_TOKEN}",
      "required": true,
      "description": "GitHub personal access token"
    }
  },
  "prerequisites": [
    {
      "binary": "npx",
      "check": "npx --version",
      "install": "npm install -g npx"
    }
  ],
  "recommends": [
    "git"
  ],
  "alternatives": [

  ],
  "requires": [

  ],
  "healthCheck": {
    "type": "stdio",
    "timeout": "5s",
    "expectTools": [
      "get_issue"
    ]
  }
}
