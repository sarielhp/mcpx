{
  "name": "context7",
  "url": "https://github.com/upstash/context7",
  "description": "Up-to-date library documentation lookup",
  "command": "npx",
  "args": [
    "-y",
    "@upstash/context7-mcp"
  ],
  "env": {
  },
  "prerequisites": [
    {
      "binary": "npx",
      "check": "npx --version",
      "install": "npm install -g npx"
    }
  ],
  "recommends": [
    "search",
    "fetch"
  ],
  "alternatives": [

  ],
  "requires": [

  ],
  "healthCheck": {
    "type": "stdio",
    "timeout": "5s",
    "expectTools": [
      "context7_query-docs"
    ]
  }
}