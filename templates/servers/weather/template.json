{
  "name": "weather",
  "description": "Weather forecasts and current conditions",
  "command": "npx",
  "args": [
    "-y",
    "@modelcontextprotocol/server-weather"
  ],
  "env": {
    "OPENWEATHER_API_KEY": {
      "value": "${OPENWEATHER_API_KEY}",
      "required": true,
      "description": "OpenWeather API key"
    }
  },
  "prerequisites": [
    {
      "binary": "npx",
      "check": "npx --version",
      "install": "npm install -g npx"
    }
  ],
  "recommends": [

  ],
  "alternatives": [

  ],
  "requires": [

  ],
  "healthCheck": {
    "type": "stdio",
    "timeout": "5s",
    "expectTools": [
      "get_weather"
    ]
  }
}
