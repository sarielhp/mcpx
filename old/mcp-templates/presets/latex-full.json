{
  "mcpServers": {
    "arxiv": {
      "command": "uvx",
      "args": ["arxiv-mcp-server"]
    },
    "semantic-scholar": {
      "command": "uvx",
      "args": ["s2-mcp-server"],
      "env": {
        "SEMANTIC_SCHOLAR_API_KEY": "${SEMANTIC_SCHOLAR_API_KEY}"
      }
    },
    "markitdown": {
      "command": "uvx",
      "args": ["markitdown-mcp"]
    },
    "sympy": {
      "command": "uvx",
      "args": ["mcp-sympy"]
    },
    "wolfram-alpha": {
      "command": "npx",
      "args": ["-y", "wolfram-mcp"],
      "env": {
        "WOLFRAM_APP_ID": "${WOLFRAM_APP_ID}"
      }
    },
    "latex": {
      "command": "uvx",
      "args": ["texflow-mcp"]
    },
    "overleaf": {
      "command": "uvx",
      "args": ["--from", "overleaf-mcp-plus", "overleaf-mcp"],
      "env": {
        "OVERLEAF_SESSION": "${OVERLEAF_SESSION}",
        "OVERLEAF_GIT_TOKEN": "${OVERLEAF_GIT_TOKEN}"
      }
    },
    "zotero": {
      "command": "npx",
      "args": ["-y", "mcp-zotero"],
      "env": {
        "ZOTERO_API_KEY": "${ZOTERO_API_KEY}",
        "ZOTERO_USER_ID": "${ZOTERO_USER_ID}"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "tavily": {
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": ["--with", "mcp<1.2.0", "mcp-server-fetch"]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "mcp-git"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{PROJECT_ROOT}}"]
    }
  }
}
