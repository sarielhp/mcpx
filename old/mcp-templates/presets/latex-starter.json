{
  "mcpServers": {
    "arxiv": {
      "command": "uvx",
      "args": ["arxiv-mcp-server"]
    },
    "markitdown": {
      "command": "uvx",
      "args": ["markitdown-mcp"]
    },
    "sympy": {
      "command": "uvx",
      "args": ["mcp-sympy"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["--with", "mcp<1.2.0", "mcp-server-fetch"]
    },
    "git": {
      "command": "npx",
      "args": ["-y", "mcp-git"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "{{PROJECT_ROOT}}"]
    }
  }
}
