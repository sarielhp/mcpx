#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'optparse'
require 'pathname'
require 'fileutils'
require 'open3'
require 'openssl'

# ANSI Color helpers
USE_COLOR = $stdout.tty? && ENV['NO_COLOR'].nil?

def colorize(text, code)
  USE_COLOR ? "\e[#{code}m#{text}\e[0m" : text
end

def bold(text);   colorize(text, '1');  end
def green(text);  colorize(text, '32'); end
def cyan(text);   colorize(text, '36'); end
def yellow(text); colorize(text, '33'); end
def red(text);    colorize(text, '31'); end
def dim(text);    colorize(text, '2');  end

# Decrypt Chromium v10 cookie
def decrypt_chromium_v10(encrypted_bytes)
  return '' if encrypted_bytes.nil? || encrypted_bytes.length < 4
  return encrypted_bytes unless encrypted_bytes.start_with?('v10')

  ciphertext = encrypted_bytes[3..]
  key = OpenSSL::PKCS5.pbkdf2_hmac('peanuts', 'saltysalt', 1, 16, 'SHA1')
  iv = ' ' * 16

  cipher = OpenSSL::Cipher.new('AES-128-CBC')
  cipher.decrypt
  cipher.key = key
  cipher.iv = iv
  cipher.update(ciphertext) + cipher.final
rescue StandardError
  ''
end

# Check SQLite for Firefox cookie
def extract_firefox_cookie(sqlite_path)
  return nil unless File.exist?(sqlite_path)

  tmp_file = "/tmp/overleaf_ff_#{Process.pid}_#{rand(10000)}.sqlite"
  FileUtils.cp(sqlite_path, tmp_file) rescue return nil

  query = "SELECT value FROM moz_cookies WHERE (host LIKE '%overleaf.com%' OR host LIKE '%sharelatex.com%') AND name = 'overleaf_session2' ORDER BY lastAccessed DESC LIMIT 1;"
  out, _, status = Open3.capture3('sqlite3', tmp_file, query)
  FileUtils.rm_f(tmp_file)

  return nil unless status.success?
  val = out.strip
  val.empty? ? nil : val
rescue StandardError
  nil
end

# Check SQLite for Chrome/Chromium/Brave cookie
def extract_chrome_cookie(sqlite_path)
  return nil unless File.exist?(sqlite_path)

  tmp_file = "/tmp/overleaf_chr_#{Process.pid}_#{rand(10000)}.sqlite"
  FileUtils.cp(sqlite_path, tmp_file) rescue return nil

  query = "SELECT encrypted_value FROM cookies WHERE (host_key LIKE '%overleaf.com%' OR host_key LIKE '%sharelatex.com%') AND name = 'overleaf_session2' ORDER BY last_access_utc DESC LIMIT 1;"
  out, _, status = Open3.capture3('sqlite3', tmp_file, query)
  FileUtils.rm_f(tmp_file)

  return nil unless status.success? || out.nil? || out.empty?

  # Query binary blob directly using sqlite3 hex
  hex_query = "SELECT hex(encrypted_value) FROM cookies WHERE (host_key LIKE '%overleaf.com%' OR host_key LIKE '%sharelatex.com%') AND name = 'overleaf_session2' ORDER BY last_access_utc DESC LIMIT 1;"
  hex_out, _, status = Open3.capture3('sqlite3', sqlite_path, hex_query)
  return nil unless status.success? && !hex_out.strip.empty?

  raw_bytes = [hex_out.strip].pack('H*')
  val = decrypt_chromium_v10(raw_bytes)
  val.empty? ? nil : val
rescue StandardError
  nil
end

# Scan all local browser profiles for existing Overleaf session
def scan_existing_browser_sessions
  home = Pathname.new(Dir.home)
  found = {}

  # Firefox profiles
  ff_profiles = Dir.glob(home.join('.mozilla/firefox/*.default*/cookies.sqlite').to_s) +
                Dir.glob(home.join('.librewolf/*.default*/cookies.sqlite').to_s)
  ff_profiles.each do |p|
    cookie = extract_firefox_cookie(p)
    found["Firefox (#{File.basename(File.dirname(p))})"] = cookie if cookie
  end

  # Chrome / Chromium / Brave profiles
  chr_profiles = {
    'Google Chrome' => Dir.glob(home.join('.config/google-chrome/*/Cookies').to_s),
    'Chromium'      => Dir.glob(home.join('.config/chromium/*/Cookies').to_s),
    'Brave Browser' => Dir.glob(home.join('.config/BraveSoftware/Brave-Browser/*/Cookies').to_s)
  }

  chr_profiles.each do |browser_name, paths|
    paths.each do |p|
      profile_name = File.basename(File.dirname(p))
      cookie = extract_chrome_cookie(p)
      found["#{browser_name} (#{profile_name})"] = cookie if cookie
    end
  end

  found
end

# Save or update keys in .env
def update_env_file(target_dir, env_updates)
  env_path = Pathname.new(target_dir).expand_path + '.env'
  lines = env_path.file? ? File.readlines(env_path, encoding: 'UTF-8') : []

  updated_keys = []
  existing_keys = {}

  # Process existing lines
  new_lines = lines.map do |line|
    stripped = line.strip
    if stripped.empty? || stripped.start_with?('#')
      line
    else
      key, = stripped.split('=', 2)
      key = key.strip
      if env_updates.key?(key)
        existing_keys[key] = true
        updated_keys << key
        "#{key}=\"#{env_updates[key]}\"\n"
      else
        line
      end
    end
  end

  # Append new keys
  env_updates.each do |k, v|
    next if existing_keys.key?(k)
    next if v.nil? || v.empty?
    new_lines << "#{k}=\"#{v}\"\n"
    updated_keys << k
  end

  File.write(env_path, new_lines.join)
  [env_path, updated_keys]
end

# Launch browser login session and extract cookie
def interactive_browser_login(target_dir, browser_choice = nil)
  temp_dir = Pathname.new('/tmp').join("overleaf_login_#{Process.pid}_#{Time.now.to_i}")
  FileUtils.mkdir_p(temp_dir)

  # Find available browser binary
  candidates = if browser_choice
                 [browser_choice]
               else
                 %w[google-chrome google-chrome-stable chromium chromium-browser brave-browser firefox]
               end

  browser_bin = candidates.find { |b| system("which #{b} >/dev/null 2>&1") }

  unless browser_bin
    warn "#{red('Error:')} No supported browser found (Chrome, Chromium, Brave, Firefox)."
    warn "Please use manual mode: run 'mcp-init overleaf-auth --manual'"
    exit 1
  end

  is_firefox = browser_bin.include?('firefox')
  login_url = 'https://www.overleaf.com/login'

  puts "\n#{bold(cyan('🌐 Launching browser for Overleaf Login...'))}"
  puts "  Browser: #{green(browser_bin)}"
  puts "  URL:     #{cyan(login_url)}\n\n"
  puts "  #{dim('1. Log in to Overleaf in the opened browser window.')}"
  puts "  #{dim('2. Once logged in, this script will automatically capture your session.')}\n\n"

  cookie_db = nil
  browser_pid = nil

  if is_firefox
    # Launch Firefox with clean temp profile
    cmd = [browser_bin, '--no-remote', '--profile', temp_dir.to_s, login_url]
    browser_pid = spawn(*cmd, out: File::NULL, err: File::NULL)
    cookie_db = temp_dir.join('cookies.sqlite')
  else
    # Launch Chromium with basic password store for instant extraction
    cookie_dir = temp_dir.join('Default')
    FileUtils.mkdir_p(cookie_dir)
    cookie_db = cookie_dir.join('Cookies')

    cmd = [
      browser_bin,
      "--user-data-dir=#{temp_dir}",
      '--password-store=basic',
      '--no-first-run',
      '--no-default-browser-check',
      login_url
    ]
    browser_pid = spawn(*cmd, out: File::NULL, err: File::NULL)
  end

  session_cookie = nil
  spinner = %w[⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏]
  spin_idx = 0
  start_time = Time.now

  print "  Waiting for login... "
  $stdout.flush

  begin
    loop do
      if is_firefox
        session_cookie = extract_firefox_cookie(cookie_db.to_s) if cookie_db.exist?
      else
        session_cookie = extract_chrome_cookie(cookie_db.to_s) if cookie_db.exist?
      end

      if session_cookie
        puts "\r  #{green('✓ Logged in successfully!')}                         "
        break
      end

      # Check if browser was closed early
      if Process.waitpid(browser_pid, Process::WNOHANG)
        puts "\r  #{yellow('Browser closed.')}                                 "
        break
      end

      spin_idx = (spin_idx + 1) % spinner.length
      printf "\r  Waiting for login... %s %ds elapsed", cyan(spinner[spin_idx]), (Time.now - start_time).to_i
      $stdout.flush
      sleep 1
    end
  rescue Interrupt
    puts "\n#{yellow('Cancelled.')}"
  ensure
    begin
      Process.kill('TERM', browser_pid) if browser_pid
    rescue StandardError
      nil
    end
  end

  unless session_cookie
    warn "\n#{red('Could not detect active Overleaf session.')}"
    warn "If you are logged in your primary browser, try: #{cyan('overleaf-auth --scan')}"
    FileUtils.rm_rf(temp_dir) rescue nil
    return nil
  end

  session_cookie
ensure
  FileUtils.rm_rf(temp_dir) rescue nil
end

# Main CLI Entry Point
def main
  options = {
    target_dir: Dir.pwd,
    scan_only: false,
    manual: false,
    browser: nil
  }

  parser = OptionParser.new do |opts|
    opts.banner = "Usage: overleaf-auth [OPTIONS]\n" \
                  "Extracts Overleaf credentials and updates .env in target workspace.\n"

    opts.separator ''
    opts.separator 'Options:'
    opts.on('-d', '--dir PATH', 'Target workspace directory for .env (default: CWD)') { |v| options[:target_dir] = v }
    opts.on('-s', '--scan', 'Scan existing local browser profiles without launching browser') { options[:scan_only] = true }
    opts.on('-m', '--manual', 'Enter credentials manually or print browser console helper') { options[:manual] = true }
    opts.on('-b', '--browser NAME', 'Specify browser binary (chrome, chromium, brave, firefox)') { |v| options[:browser] = v }
    opts.on('-h', '--help', 'Show this help message') { puts opts; exit 0 }
  end

  parser.parse!(ARGV)
  target_path = Pathname.new(options[:target_dir]).expand_path

  puts "\n#{bold('🍃 Overleaf Credentials Extractor')}"
  puts "  #{dim('Target .env Directory:')} #{cyan(target_path.to_s)}\n\n"

  session_cookie = nil

  if options[:scan_only]
    puts "#{bold('Scanning installed browsers for Overleaf sessions...')}"
    found = scan_existing_browser_sessions

    if found.empty?
      puts "  #{yellow('No active Overleaf session found in existing browser profiles.')}"
      puts "  Run #{cyan('overleaf-auth')} to log in via a browser window.\n\n"
      exit 0
    else
      found.each do |browser, cookie|
        puts "  #{green('✓')} Found session in #{bold(browser)}: #{dim(cookie[0..16] + '...')}"
        session_cookie ||= cookie
      end
    end
  elsif options[:manual]
    puts "#{bold('Manual Credential Configuration:')}\n"
    puts "  To copy your session cookie directly from your browser:"
    puts "  1. Open #{cyan('https://www.overleaf.com')} in your browser"
    puts "  2. Press F12 -> Application/Storage -> Cookies -> overleaf.com"
    puts "  3. Copy the value of #{bold('overleaf_session2')}\n\n"

    print "#{bold('Paste OVERLEAF_SESSION cookie:')} "
    session_cookie = $stdin.gets&.strip
  else
    # 1. First quick scan existing profiles
    found = scan_existing_browser_sessions
    if found.any?
      browser_name, cookie = found.first
      puts "  #{green('✓')} Detected active session in #{bold(browser_name)}!"
      session_cookie = cookie
    else
      # 2. Launch interactive browser login
      session_cookie = interactive_browser_login(target_path, options[:browser])
    end
  end

  if session_cookie.nil? || session_cookie.empty?
    warn "#{red('Error:')} No session cookie obtained."
    exit 1
  end

  # Prompt for optional Git token
  git_token = nil
  if $stdin.tty?
    puts "\n#{bold('Optional Overleaf Git Token (for write/commit access):')}"
    puts "  Get your Git Token at: #{cyan('https://www.overleaf.com/user/settings')} (Git Integration section)"
    print "  Enter OVERLEAF_GIT_TOKEN (press Enter to skip): "
    git_token = $stdin.gets&.strip
    git_token = nil if git_token&.empty?
  end

  env_updates = { 'OVERLEAF_SESSION' => session_cookie }
  env_updates['OVERLEAF_GIT_TOKEN'] = git_token if git_token

  env_file, updated_keys = update_env_file(target_path, env_updates)

  puts "\n#{green('✓ Successfully saved Overleaf credentials!')}"
  puts "  #{dim('File:')}    #{cyan(env_file.to_s)}"
  puts "  #{dim('Keys:')}    #{green(updated_keys.join(', '))}\n\n"

  puts "You can now initialize or test your LaTeX workspace:"
  puts "  #{cyan('mcp-init latex-overleaf')}"
  puts "  #{cyan('mcp-init test overleaf')}\n\n"
end

main if __FILE__ == $PROGRAM_NAME
