# Main CLI Entry Point
def main
  # Handle top-level help first
  if ARGV.include?('--help') || ARGV.include?('-h')
    if ARGV.length == 1
      show_main_help
      exit 0
    end
  end

  # Handle overleaf-auth as a special case before parsing
  if ARGV.first&.downcase == 'overleaf-auth' || ARGV.first&.downcase == 'auth-overleaf'
    ARGV.shift
    exec((TEMPLATE_DIR + 'bin' + 'overleaf-auth').to_s, *ARGV)
  end

  # Parse commands
  if ARGV.empty?
    show_main_help
    exit 0
  end

  command = ARGV.shift.downcase

  case command
  when 'local'
    if ARGV.empty?
      show_local_help
      exit 0
    end

    subcommand = ARGV.shift.downcase

    case subcommand
    when '--help', '-h'
      show_local_help
      exit 0
    when 'add'
      handle_local_add(ARGV)
    when 'rm', 'remove'
      handle_local_rm(ARGV)
    when 'list', 'ls'
      handle_local_list(ARGV)
    when 'test'
      handle_local_test(ARGV)
    when 'update'
      handle_local_update(ARGV)
    else
      warn "#{red('Error:')} Unknown local subcommand '#{subcommand}'"
      show_local_help
      exit 1
    end
  when 'template'
    if ARGV.empty?
      show_template_help
      exit 0
    end

    subcommand = ARGV.shift.downcase

    case subcommand
    when '--help', '-h'
      show_template_help
      exit 0
    when 'list', 'ls'
      handle_template_list(ARGV)
    when 'show'
      handle_template_show(ARGV)
    else
      warn "#{red('Error:')} Unknown template subcommand '#{subcommand}'"
      show_template_help
      exit 1
    end
  when 'auth'
    if ARGV.empty?
      show_auth_help
      exit 0
    end

    subcommand = ARGV.shift.downcase

    case subcommand
    when '--help', '-h'
      show_auth_help
      exit 0
    when 'set'
      handle_auth_set(ARGV)
    when 'list', 'status'
      handle_auth_list(ARGV)
    when 'get'
      handle_auth_get(ARGV)
    when 'rm'
      handle_auth_rm(ARGV)
    when 'overleaf'
      handle_auth_overleaf(ARGV)
    else
      warn "#{red('Error:')} Unknown auth subcommand '#{subcommand}'"
      show_auth_help
      exit 1
    end
  when 'add'
    # Shorthand for local add
    ARGV.unshift('add')
    ARGV.unshift('local')
    # Re-parse with full command structure
    command = 'local'
    subcommand = 'add'
    ARGV.shift # remove 'add'
    ARGV.shift # remove 'local'
    handle_local_add(ARGV)
  when 'rm', 'remove'
    # Shorthand for local rm
    ARGV.unshift(command)
    ARGV.unshift('local')
    # Re-parse with full command structure
    command = 'local'
    subcommand = command
    ARGV.shift # remove rm/remove
    ARGV.shift # remove local
    handle_local_rm(ARGV)
  when 'list', 'ls'
    # Shorthand for template list
    ARGV.unshift(command)
    ARGV.unshift('template')
    # Re-parse with full command structure
    command = 'template'
    subcommand = command
    ARGV.shift # remove list/ls
    ARGV.shift # remove template
    handle_template_list(ARGV)
  when 'show'
    # Shorthand for template show
    ARGV.unshift(command)
    ARGV.unshift('template')
    # Re-parse with full command structure
    command = 'template'
    subcommand = command
    ARGV.shift # remove show
    ARGV.shift # remove template
    handle_template_show(ARGV)
  when 'status'
    # Shorthand for local list
    ARGV.unshift('list')
    ARGV.unshift('local')
    # Re-parse with full command structure
    command = 'local'
    subcommand = 'list'
    ARGV.shift # remove list
    ARGV.shift # remove local
    handle_local_list(ARGV)
  when 'test'
    # Shorthand for local test
    ARGV.unshift(command)
    ARGV.unshift('local')
    # Re-parse with full command structure
    command = 'local'
    subcommand = command
    ARGV.shift # remove test
    ARGV.shift # remove local
    handle_local_test(ARGV)
  when 'update'
    # Shorthand for local update
    ARGV.unshift(command)
    ARGV.unshift('local')
    # Re-parse with full command structure
    command = 'local'
    subcommand = command
    ARGV.shift # remove update
    ARGV.shift # remove local
    handle_local_update(ARGV)
  else
    # Backward compatibility: treat as local add
    ARGV.unshift(command)
    ARGV.unshift('add')
    ARGV.unshift('local')
    # Re-parse with full command structure
    command = 'local'
    subcommand = 'add'
    ARGV.shift # remove add
    ARGV.shift # remove local
    ARGV.shift # remove the original command
    handle_local_add(ARGV)
  end
end

