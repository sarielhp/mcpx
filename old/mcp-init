# Load environment variables from multiple sources
def load_dotenv(target_dir)
  # Load system environment first (highest priority)
  vars = ENV.to_h
  
  # Load template directory .env (base credentials)
  template_env_file = TEMPLATE_DIR + '.env'
  if template_env_file.file?
    File.readlines(template_env_file, encoding: 'UTF-8').each do |line|
      line = line.strip
      next if line.empty? || line.start_with?('#')
      key, val = line.split('=', 2)
      next unless key && val
      key = key.strip
      val = val.strip
      if (val.start_with?('"') && val.end_with?('"')) || (val.start_with?("'") && val.end_with?("'"))
        val = val[1..-2]
      end
      vars[key] = val
    end
  end
  
  # Load target directory .env (local overrides)
  env_file = Pathname.new(target_dir) + '.env'
  if env_file.file?
    File.readlines(env_file, encoding: 'UTF-8').each do |line|
      line = line.strip
      next if line.empty? || line.start_with?('#')
      key, val = line.split('=', 2)
      next unless key && val
      key = key.strip
      val = val.strip
      if (val.start_with?('"') && val.end_with?('"')) || (val.start_with?("'") && val.end_with?("'"))
        val = val[1..-2]
      end
      vars[key] = val
    end
  end
  
  vars
end

def load_json_file(path)
  raw = File.read(path, encoding: 'UTF-8')
  # Strip simple single-line comments for JSONC compatibility
  cleaned = raw.lines.reject { |line| line.strip.start_with?('//', '#') }.join
  JSON.parse(cleaned)
end

def replace_placeholders(obj, target_dir, dotenv_vars = nil)
  dotenv_vars ||= load_dotenv(target_dir)

  case obj
  when String
    res = obj.gsub('{{PROJECT_ROOT}}', target_dir)
             .gsub('{{CWD}}', target_dir)
             .gsub('${PROJECT_ROOT}', target_dir)
             .gsub('${PWD}', target_dir)
    dotenv_vars.each do |k, v|
      res = res.gsub("${#{k}}", v).gsub("{{#{k}}}", v)
    end
    res
  when Array
    obj.map { |item| replace_placeholders(item, target_dir, dotenv_vars) }
  when Hash
    obj.transform_values { |v| replace_placeholders(v, target_dir, dotenv_vars) }
  else
    obj
  end
end

def normalize_server_definition(name, raw_def)
  normalized = {}

  # Remote server
  server_url = raw_def['serverUrl'] || raw_def['url']
  if server_url || raw_def['type'] == 'remote'
    normalized['serverUrl'] = server_url
    normalized['headers'] = raw_def['headers'] if raw_def['headers']
    return normalized
  end

  # Command handling
  cmd = raw_def['command']
  if cmd.is_a?(Array) && !cmd.empty?
    normalized['command'] = cmd.first
    normalized['args'] = cmd[1..]
  elsif cmd.is_a?(String)
    normalized['command'] = cmd
    normalized['args'] = raw_def['args'] if raw_def['args'].is_a?(Array)
  end

  # Environment variables
  env = raw_def['env'] || raw_def['environment']
  normalized['env'] = env if env.is_a?(Hash)

  normalized
end

def to_opencode_format(norm_def)
  if norm_def['serverUrl']
    out = {
      'type' => 'remote',
      'url' => norm_def['serverUrl'],
      'enabled' => true
    }
    out['headers'] = norm_def['headers'] if norm_def['headers']
    return out
  end

  cmd_arr = [norm_def['command']].compact
  cmd_arr += norm_def['args'] if norm_def['args'].is_a?(Array)

  out = {
    'type' => 'local',
    'command' => cmd_arr,
    'enabled' => true
  }
  out['environment'] = norm_def['env'] if norm_def['env'] && !norm_def['env'].empty?
  out
end

def to_standard_format(norm_def)
  if norm_def['serverUrl']
    out = { 'serverUrl' => norm_def['serverUrl'] }
    out['headers'] = norm_def['headers'] if norm_def['headers']
    return out
  end

  out = { 'command' => norm_def['command'] }
  out['args'] = norm_def['args'] if norm_def['args']
  out['env'] = norm_def['env'] if norm_def['env'] && !norm_def['env'].empty?
  out
end

def get_available_presets
  presets = {}
  if PRESETS_DIR.directory?
    PRESETS_DIR.glob('*.json').sort.each do |p|
      presets[p.basename('.json').to_s] = p
    end
  end
  presets
end

def get_available_servers
  servers = {}
  if SERVERS_DIR.directory?
    SERVERS_DIR.glob('*.json').sort.each do |p|
      servers[p.basename('.json').to_s] = p
    end
  end
  servers
end

def load_items(items, target_dir)
  presets = get_available_presets
  servers = get_available_servers
  combined = {}

  items.each do |item|
    item_path = Pathname.new(item).expand_path
    if item_path.file?
      data = load_json_file(item_path)
      data = replace_placeholders(data, target_dir)
      if data['mcpServers'].is_a?(Hash)
        data['mcpServers'].each { |k, v| combined[k] = normalize_server_definition(k, v) }
      elsif data['mcp'].is_a?(Hash)
        data['mcp'].each { |k, v| combined[k] = normalize_server_definition(k, v) }
      elsif data.is_a?(Hash)
        data.each { |k, v| combined[k] = normalize_server_definition(k, v) if v.is_a?(Hash) }
      end
      next
    end

    if presets.key?(item)
      data = load_json_file(presets[item])
      data = replace_placeholders(data, target_dir)
      server_dict = data['mcpServers'] || data
      if server_dict.is_a?(Hash)
        server_dict.each { |k, v| combined[k] = normalize_server_definition(k, v) }
      end
      next
    end

    if servers.key?(item)
      data = load_json_file(servers[item])
      data = replace_placeholders(data, target_dir)
      if data[item].is_a?(Hash)
        combined[item] = normalize_server_definition(item, data[item])
      elsif data.is_a?(Hash)
        data.each { |k, v| combined[k] = normalize_server_definition(k, v) if v.is_a?(Hash) }
      end
      next
    end

    warn "#{red('Error:')} Item '#{item}' is not a known preset or server, and not a valid file path."
    warn "Run 'mcp-init --list' to see available presets and servers."
    exit 1
  end

  combined
end

# Testing Subsystem
def executable_in_path?(cmd)
  ENV['PATH'].to_s.split(File::PATH_SEPARATOR).any? do |dir|
    file = File.join(dir, cmd)
    File.executable?(file) && !File.directory?(file)
  end
end

def read_json_response_with_timeout(stdout, timeout_sec, target_id = nil)
  end_time = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_sec
  loop do
    remaining = end_time - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    return nil if remaining <= 0

    ready = IO.select([stdout], nil, nil, [remaining, 0.05].max)
    return nil unless ready && ready[0].include?(stdout)

    line = stdout.gets
    return nil if line.nil?
    line = line.strip
    next if line.empty?

    begin
      parsed = JSON.parse(line)
      if target_id.nil? || parsed['id'] == target_id || parsed.key?('result') || parsed.key?('error')
        return parsed
      end
    rescue JSON::ParserError
      # Skip non-JSON stdout logs
    end
  end
end

def test_mcp_server(name, srv_def, target_dir, timeout_sec = 8, verbose = false)
  norm = normalize_server_definition(name, srv_def)

  if norm['serverUrl']
    return {
      status: :skipped,
      message: "Remote server (#{norm['serverUrl']}): live HTTP probe not run in stdio test mode",
      duration_ms: 0
    }
  end

  command = norm['command']
  args = (norm['args'] || []).map { |a| replace_placeholders(a, target_dir.to_s) }
  env = norm['env'] || {}

  unless executable_in_path?(command)
    return {
      status: :error,
      message: "Command executable '#{command}' not found in PATH",
      duration_ms: 0
    }
  end

  full_cmd = [command] + args
  start_time = Process.clock_gettime(Process::CLOCK_MONOTONIC)

  init_req = {
    jsonrpc: '2.0',
    id: 1,
    method: 'initialize',
    params: {
      protocolVersion: '2024-11-05',
      capabilities: {},
      clientInfo: { name: 'mcp-init-test', version: '1.0.0' }
    }
  }.to_json + "\n"

  notif_init = { jsonrpc: '2.0', method: 'notifications/initialized' }.to_json + "\n"
  tools_req = { jsonrpc: '2.0', id: 2, method: 'tools/list', params: {} }.to_json + "\n"

  dotenv_vars = load_dotenv(target_dir)
  merged_env = ENV.to_h.merge(dotenv_vars).merge(env)

  begin
    Open3.popen3(merged_env, *full_cmd, chdir: target_dir.to_s) do |stdin, stdout, stderr, wait_thr|
      stdin.write(init_req)
      stdin.flush

      init_resp = read_json_response_with_timeout(stdout, timeout_sec, 1)

      if init_resp.nil?
        stderr_sample = begin
          stderr.read_nonblock(500)
        rescue StandardError
          ''
        end
        stdin.close rescue nil
        Process.kill('KILL', wait_thr.pid) rescue nil
        duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - start_time) * 1000).round

        msg = if stderr_sample.strip.empty?
                "Timed out after #{timeout_sec}s with no initialize response"
              else
                stderr_sample.strip.lines.first(2).join(' ').strip
              end

        return {
          status: :error,
          message: msg,
          duration_ms: duration_ms
        }
      end

      # Send notifications/initialized and tools/list
      stdin.write(notif_init)
      stdin.write(tools_req)
      stdin.flush

      tools_resp = read_json_response_with_timeout(stdout, 3, 2)
      tools_list = (tools_resp&.dig('result', 'tools') || []).map { |t| t['name'] }

      stdin.close rescue nil
      Process.kill('KILL', wait_thr.pid) rescue nil

      duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - start_time) * 1000).round
      server_info = init_resp.dig('result', 'serverInfo') || {}
      srv_name = server_info['name'] || name
      srv_ver  = server_info['version'] || ''

      return {
        status: :ok,
        server_info: "#{srv_name} #{srv_ver}".strip,
        tools: tools_list,
        duration_ms: duration_ms
      }
    end
  rescue StandardError => e
    duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - start_time) * 1000).round
    {
      status: :error,
      message: e.message,
      duration_ms: duration_ms
    }
  end
end

def cmd_test(target_items, target_dir, timeout_sec = 8, verbose = false)
  all_servers = get_available_servers
  servers_to_test = {}

  if target_items.empty?
    # Test all servers
    all_servers.each do |name, path|
      begin
        data = load_json_file(path)
        servers_to_test[name] = data[name] || data
      rescue StandardError => e
        warn "#{yellow('!')} Failed to load #{path}: #{e.message}"
      end
    end
  else
    target_items.each do |item|
      if all_servers.key?(item)
        data = load_json_file(all_servers[item])
        servers_to_test[item] = data[item] || data
      else
        # Try loading as preset or custom items
        begin
          loaded = load_items([item], target_dir.to_s)
          loaded.each { |k, v| servers_to_test[k] = v }
        rescue StandardError => e
          warn "#{red('Error:')} Could not load '#{item}' to test: #{e.message}"
        end
      end
    end
  end

  if servers_to_test.empty?
    warn "#{red('Error:')} No servers found to test."
    exit 1
  end

  puts "\n#{bold('🧪 Testing MCP Server Handshakes')} (#{servers_to_test.size} servers)\n"
  puts "  #{dim('Working Directory:')} #{cyan(target_dir.to_s)}"
  puts "  #{dim('Timeout:')}           #{timeout_sec}s\n\n"

  passed = 0
  failed = 0
  skipped = 0

  servers_to_test.each do |name, defn|
    printf "  %-18s ", bold(name)
    $stdout.flush

    res = test_mcp_server(name, defn, target_dir, timeout_sec, verbose)

    case res[:status]
    when :ok
      passed += 1
      tools_info = res[:tools].empty? ? 'no tools' : "#{res[:tools].size} tools: #{res[:tools].first(4).join(', ')}#{res[:tools].size > 4 ? '...' : ''}"
      puts "#{green('✓ PASS')} #{dim("[#{res[:duration_ms]}ms]")} #{dim('→')} #{dim(res[:server_info])} #{cyan("(#{tools_info})")}"
    when :skipped
      skipped += 1
      puts "#{yellow('• SKIP')} #{dim(res[:message])}"
    when :error
      failed += 1
      puts "#{red('✗ FAIL')} #{dim("[#{res[:duration_ms]}ms]")} #{dim('→')} #{red(res[:message])}"
    end
  end

  puts "\n#{bold('Test Summary:')} #{green("#{passed} passed")}, #{failed > 0 ? red("#{failed} failed") : '0 failed'}, #{skipped} skipped.\n\n"
  exit(failed > 0 ? 1 : 0)
end

# Target Handlers
def apply_antigravity(target_dir, servers, overwrite, dry_run)
  plugin_dir = target_dir + '.agents' + 'plugins' + 'mcp'
  mcp_file = plugin_dir + 'mcp_config.json'
  manifest_file = plugin_dir + 'plugin.json'

  target_mcp_servers = servers.transform_values { |v| to_standard_format(v) }

  status = 'Created'
  existing_data = {}
  if mcp_file.file? && !overwrite
    status = 'Updated'
    begin
      existing_data = load_json_file(mcp_file)
    rescue StandardError
      existing_data = {}
    end
  end

  current_servers = existing_data['mcpServers'].is_a?(Hash) ? existing_data['mcpServers'] : {}
  merged_servers = current_servers.merge(target_mcp_servers)

  final_config = { 'mcpServers' => merged_servers }
  manifest = {
    'name' => 'mcp',
    'description' => 'Workspace MCP server configuration'
  }

  unless dry_run
    FileUtils.mkdir_p(plugin_dir)
    unless manifest_file.file? && !overwrite
      File.write(manifest_file, JSON.pretty_generate(manifest) + "\n")
    end
    File.write(mcp_file, JSON.pretty_generate(final_config) + "\n")
  end

  [mcp_file, status, merged_servers.keys]
end

def apply_opencode(target_dir, servers, overwrite, dry_run)
  dot_opencode = target_dir + '.opencode' + 'opencode.json'
  root_opencode = target_dir + 'opencode.json'

  target_file = if dot_opencode.file?
                  dot_opencode
                elsif root_opencode.file?
                  root_opencode
                elsif (target_dir + '.opencode').directory?
                  dot_opencode
                else
                  root_opencode
                end

  opencode_servers = servers.transform_values { |v| to_opencode_format(v) }

  status = 'Created'
  existing_config = {}
  if target_file.file? && !overwrite
    status = 'Updated'
    begin
      existing_config = load_json_file(target_file)
    rescue StandardError
      existing_config = {}
    end
  end

  final_config = existing_config.dup
  final_config['$schema'] ||= 'https://opencode.ai/config.json'

  current_mcp = final_config['mcp'].is_a?(Hash) ? final_config['mcp'] : {}
  merged_mcp = current_mcp.merge(opencode_servers)
  final_config['mcp'] = merged_mcp

  unless dry_run
    FileUtils.mkdir_p(target_file.parent)
    File.write(target_file, JSON.pretty_generate(final_config) + "\n")
  end

  [target_file, status, merged_mcp.keys]
end

def apply_standard_dir(target_dir, subdir, filename, servers, overwrite, dry_run)
  out_dir = target_dir + subdir
  out_file = out_dir + filename

  target_mcp_servers = servers.transform_values { |v| to_standard_format(v) }

  status = 'Created'
  existing_data = {}
  if out_file.file? && !overwrite
    status = 'Updated'
    begin
      existing_data = load_json_file(out_file)
    rescue StandardError
      existing_data = {}
    end
  end

  current_servers = existing_data['mcpServers'].is_a?(Hash) ? existing_data['mcpServers'] : {}
  merged_servers = current_servers.merge(target_mcp_servers)
  final_config = { 'mcpServers' => merged_servers }

  unless dry_run
    FileUtils.mkdir_p(out_dir)
    File.write(out_file, JSON.pretty_generate(final_config) + "\n")
  end

  [out_file, status, merged_servers.keys]
end

def cmd_list
  presets = get_available_presets
  servers = get_available_servers

  puts "\n#{bold(cyan('📦 Available MCP Presets:'))} (#{TEMPLATE_DIR}/presets)"
  if presets.empty?
    puts "  #{dim('No presets found.')}"
  else
    presets.keys.sort.each do |name|
      begin
        data = load_json_file(presets[name])
        s_dict = data['mcpServers'] || data
        srv_names = s_dict.is_a?(Hash) ? s_dict.keys.join(', ') : ''
        printf "  • %-20s %s %s\n", bold(name), dim('→'), cyan(srv_names)
      rescue StandardError
        printf "  • %s\n", bold(name)
      end
    end
  end

  puts "\n#{bold(green('🔌 Available MCP Individual Servers:'))} (#{TEMPLATE_DIR}/servers)"
  if servers.empty?
    puts "  #{dim('No server templates found.')}"
  else
    servers.keys.sort.each do |name|
      begin
        data = load_json_file(servers[name])
        s_def = data[name] || data
        cmd = s_def['command'] || s_def['serverUrl'] || ''
        args = (s_def['args'] || []).join(' ')
        desc = "#{cmd} #{args}".strip
        desc = "#{desc[0...57]}..." if desc.length > 60
        printf "  • %-20s %s %s\n", bold(name), dim('→'), dim(desc)
      rescue StandardError
        printf "  • %s\n", bold(name)
      end
    end
  end
  puts
end

def cmd_show(name)
  presets = get_available_presets
  servers = get_available_servers

  if presets.key?(name)
    puts "#{bold(cyan("Preset: #{name}"))} (#{presets[name]})"
    puts File.read(presets[name])
  elsif servers.key?(name)
    puts "#{bold(green("Server: #{name}"))} (#{servers[name]})"
    puts File.read(servers[name])
  else
    warn "#{red('Error:')} No preset or server found matching '#{name}'"
    exit 1
  end
end

