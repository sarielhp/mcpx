# Update Command Implementation
def cmd_update(target_dir, server_names = [])
  puts "\n#{bold('🔄 Updating MCP Configurations with Latest Credentials')}"
  puts "  #{dim('Target Directory:')} #{cyan(target_dir.to_s)}\n\n"

  # Detect installed MCP configurations
  configs = {}
  
  # Antigravity
  agy_file = target_dir + '.agents' + 'plugins' + 'mcp' + 'mcp_config.json'
  configs[:antigravity] = agy_file if agy_file.file?
  
  # OpenCode
  opencode_files = [target_dir + 'opencode.json', target_dir + '.opencode' + 'opencode.json']
  opencode_files.each { |f| configs[:opencode] = f if f.file? }
  
  # Cursor
  cursor_file = target_dir + '.cursor' + 'mcp.json'
  configs[:cursor] = cursor_file if cursor_file.file?
  
  # Claude
  claude_file = target_dir + '.claude' + 'mcp.json'
  configs[:claude] = claude_file if claude_file.file?
  
  # VS Code
  vscode_file = target_dir + '.vscode' + 'mcp.json'
  configs[:vscode] = vscode_file if vscode_file.file?

  if configs.empty?
    puts "#{yellow('!')} No MCP configurations found in #{target_dir}"
    return
  end

  updated_count = 0

  configs.each do |platform, config_file|
    begin
      data = load_json_file(config_file)
      
      # Extract server names from the config
      servers_section = case platform
                        when :antigravity, :cursor, :claude, :vscode
                          data['mcpServers'] || {}
                        when :opencode
                          data['mcp'] || {}
                        else
                          {}
                        end
      
      server_names_in_config = servers_section.keys
      
      # If specific servers were requested, filter to those
      if server_names.any?
        server_names_in_config = server_names_in_config & server_names
      end
      
      next if server_names_in_config.empty?

      # Reload the server definitions with updated credentials
      updated_servers = load_items(server_names_in_config, target_dir.to_s)
      
      # Update the config with refreshed server definitions
      case platform
      when :antigravity, :cursor, :claude, :vscode
        data['mcpServers'] = servers_section.merge(updated_servers.transform_values { |v| to_standard_format(v) })
      when :opencode
        data['mcp'] = servers_section.merge(updated_servers.transform_values { |v| to_opencode_format(v) })
      end
      
      # Write updated config
      File.write(config_file, JSON.pretty_generate(data) + "\n")
      puts "  #{green('✓')} Updated #{platform} config with #{server_names_in_config.length} servers"
      updated_count += server_names_in_config.length
      
    rescue StandardError => e
      puts "  #{red('✗')} Failed to update #{platform} config: #{e.message}"
    end
  end

  puts "\n#{bold('Update Summary:')} #{green("#{updated_count} servers updated")} across #{configs.length} platforms.\n\n"
end

