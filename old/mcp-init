# Auth Commands Implementation
def cmd_auth_set(server_or_var, value = nil, target_dir = TEMPLATE_DIR.to_s)
  # If value is not provided, prompt for it
  if value.nil?
    if server_or_var.is_a?(Array) && server_or_var.length > 1
      # Multiple values needed
      values = []
      server_or_var.each do |var|
        print "Enter value for #{var}: "
        values << gets.chomp.strip
      end
      value = values
    else
      var_name = server_or_var.is_a?(Array) ? server_or_var.first : server_or_var
      print "Enter value for #{var_name}: "
      value = gets.chomp.strip
    end
  end

  # Determine the environment variable name(s)
  env_vars = if SERVER_ENV_MAP.key?(server_or_var)
               env_key = SERVER_ENV_MAP[server_or_var]
               env_key.is_a?(Array) ? env_key : [env_key]
             elsif SERVER_ENV_MAP.values.flatten.include?(server_or_var)
               [server_or_var]
             elsif SERVER_ENV_MAP.values.any? { |v| v.is_a?(Array) && v.include?(server_or_var) }
               [server_or_var]
             else
               [server_or_var] # Raw variable name
             end

  # Handle multiple values
  values = value.is_a?(Array) ? value : [value]

  # Update the .env file
  env_path = Pathname.new(target_dir).expand_path + '.env'
  lines = env_path.file? ? File.readlines(env_path, encoding: 'UTF-8') : []

  updated_keys = []
  existing_keys = {}

  # Process existing lines
  new_lines = lines.map do |line|
    stripped = line.strip
    if stripped.empty? || stripped.start_with?('#')
      line
    else
      key, = stripped.split('=', 2)
      key = key.strip
      if env_vars.include?(key)
        existing_keys[key] = true
        updated_keys << key
        val = values[env_vars.index(key)] || values.first
        "#{key}=\"#{val}\"\n"
      else
        line
      end
    end
  end

  # Append new keys
  env_vars.each_with_index do |var, index|
    next if existing_keys.key?(var)
    val = values[index] || values.first
    next if val.nil? || val.empty?
    new_lines << "#{var}=\"#{val}\"\n"
    updated_keys << var
  end

  FileUtils.mkdir_p(env_path.parent)
  File.write(env_path, new_lines.join)
  File.chmod(0600, env_path) if env_path.file?

  puts "#{green('✓')} Updated #{updated_keys.join(', ')} in #{dim(env_path.to_s)}"
  
  updated_keys
end

def cmd_auth_list(target_dir = TEMPLATE_DIR.to_s)
  # Load template .env file
  template_env_file = TEMPLATE_DIR + '.env'
  template_vars = {}
  if template_env_file.file?
    File.readlines(template_env_file, encoding: 'UTF-8').each do |line|
      line = line.strip
      next if line.empty? || line.start_with?('#')
      key, val = line.split('=', 2)
      next unless key && val
      key = key.strip
      val = val.strip
      if (val.start_with?('"') && val.end_with?('"')) || (val.start_with?("'") && val.end_with?("'"))
        val = val[1..-2]
      end
      template_vars[key] = val
    end
  end

  # Load target .env file
  target_env_file = Pathname.new(target_dir).expand_path + '.env'
  target_vars = {}
  if target_env_file.file?
    File.readlines(target_env_file, encoding: 'UTF-8').each do |line|
      line = line.strip
      next if line.empty? || line.start_with?('#')
      key, val = line.split('=', 2)
      next unless key && val
      key = key.strip
      val = val.strip
      if (val.start_with?('"') && val.end_with?('"')) || (val.start_with?("'") && val.end_with?("'"))
        val = val[1..-2]
      end
      target_vars[key] = val
    end
  end

  # Combine all known environment variables from templates
  all_known_vars = Set.new
  Dir.glob(SERVERS_DIR + '*.json').each do |file|
    begin
      data = load_json_file(file)
      server_data = data.values.first || data
      if server_data.is_a?(Hash) && server_data['env'].is_a?(Hash)
        server_data['env'].keys.each { |k| all_known_vars.add(k) }
      end
    rescue StandardError
      # Skip files that can't be parsed
    end
  end

  Dir.glob(PRESETS_DIR + '*.json').each do |file|
    begin
      data = load_json_file(file)
      servers_section = data['mcpServers'] || data
      if servers_section.is_a?(Hash)
        servers_section.values.each do |server_data|
          if server_data.is_a?(Hash) && server_data['env'].is_a?(Hash)
            server_data['env'].keys.each { |k| all_known_vars.add(k) }
          end
        end
      end
    rescue StandardError
      # Skip files that can't be parsed
    end
  end

  puts "\n#{bold('🔐 API Keys & Credentials Status')}"
  puts "  #{dim('Template Directory:')} #{cyan(TEMPLATE_DIR.to_s)}"
  puts "  #{dim('Target Directory:')}  #{cyan(target_dir)}\n\n"

  all_known_vars.sort.each do |var|
    if target_vars.key?(var)
      masked_val = target_vars[var][0..6] + '***' + target_vars[var][-4..-1].to_s
      source = 'local'
      puts "  #{green('✓')} #{bold(var.ljust(25))} #{cyan(masked_val)} #{dim("(#{source})")}"
    elsif template_vars.key?(var)
      masked_val = template_vars[var][0..6] + '***' + template_vars[var][-4..-1].to_s
      source = 'template'
      puts "  #{green('✓')} #{bold(var.ljust(25))} #{cyan(masked_val)} #{dim("(#{source})")}"
    else
      puts "  #{red('✗')} #{bold(var.ljust(25))} #{dim('Missing')}"
    end
  end

  # Show any extra variables in .env files
  extra_template = template_vars.keys - all_known_vars.to_a
  extra_target = target_vars.keys - all_known_vars.to_a

  unless extra_template.empty?
    puts "\n  #{yellow('Additional template variables:')}"
    extra_template.each { |var| puts "    #{var}" }
  end

  unless extra_target.empty?
    puts "\n  #{yellow('Additional target variables:')}"
    extra_target.each { |var| puts "    #{var}" }
  end

  puts
end

